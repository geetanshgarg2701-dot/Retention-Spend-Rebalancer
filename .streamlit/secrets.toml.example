# Copy this to .streamlit/secrets.toml for local runs, or paste it into the Secrets box when you deploy.
# Put your real key in the copy, never in this example file. The real secrets.toml is ignored by git.
GEMINI_API_KEY = "your-key-here"
GEMINI_MODEL = "gemini-3.5-flash-lite"
# The most AI calls all visitors together may make in one UTC day. The free tier is shared, so keep this below its limit.
AI_DAILY_LIMIT = "150"
